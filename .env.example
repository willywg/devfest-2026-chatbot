# Crea tu key gratuita en https://aistudio.google.com/apikey (sin facturación)
GOOGLE_API_KEY=
# Modelo principal: 15 peticiones por minuto y 500 por día en el plan gratuito
MODEL=gemini-3.5-flash-lite
# Respaldo si el principal está saturado (error 503): más lento, pero con más cuota
FALLBACK_MODEL=gemma-4-31b-it
